# Copy to .env.kalshi and fill in. Never commit the real file (.gitignore excludes it).
KALSHI_API_KEY_ID=00000000-0000-0000-0000-000000000000
KALSHI_PRIVATE_KEY_PATH=/path/to/kalshi_private_key.pem
KALSHI_API_BASE=https://external-api.kalshi.com/trade-api/v2
KALSHI_WS_BASE=wss://external-api-ws.kalshi.com/trade-api/ws/v2
